generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MERCHANT
  CUSTOMER
  EMPLOYEE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum PaymentMethod {
  CASH
  MOBILE_PAYMENT
  TRANSFER

  @@map("payment_method")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  phone         String?
  cedula        String?   @unique
  pin           String?   // PIN de 4 dígitos para login (staff)
  password      String?   // Hash bcrypt para login email/contraseña (cliente/comercio)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  clientOrders       Order[]              @relation("ClientOrders")
  riderOrders        Order[]              @relation("RiderOrders")
  locations          Location[]
  managedRestaurants Restaurant[]         @relation("AdminRestaurant")
  ownedBusinesses    Business[]           @relation("OwnedBusinesses")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Business {
  id          String   @id @default(cuid())
  ownerId     String?  @map("owner_id")
  name        String
  slug        String   @unique
  description String?  @db.Text
  logo        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User?         @relation("OwnedBusinesses", fields: [ownerId], references: [id], onDelete: SetNull)
  restaurants Restaurant[]

  @@index([ownerId])
  @@map("businesses")
}

model Restaurant {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  adminId    String   @map("admin_id")
  name       String
  address    String
  phone      String?
  lat        Float
  lng        Float
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  admin      User           @relation("AdminRestaurant", fields: [adminId], references: [id])
  categories MenuCategory[]
  menuItems  MenuItem[]
  orders     Order[]
  tables     Table[]

  @@map("restaurants")
}

model MenuCategory {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  name         String
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items      MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id           String  @id @default(cuid())
  restaurantId String  @map("restaurant_id")
  categoryId   String  @map("category_id")
  name         String
  description  String? @db.Text
  price        Decimal @db.Decimal(10, 2)
  image        String?
  available    Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("menu_items")
}

enum ServiceType {
  MESA
  DELIVERY

  @@map("service_type")
}

model Table {
  id           String   @id @default(cuid())
  restaurantId String   @map("restaurant_id")
  number       Int
  qrCode       String?  @map("qr_code")
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, number])
  @@map("tables")
}

model Order {
  id              String         @id @default(cuid())
  clientId        String         @map("client_id")
  restaurantId    String         @map("restaurant_id")
  riderId         String?        @map("rider_id")
  status          OrderStatus    @default(PENDING)
  totalPrice      Decimal        @db.Decimal(10, 2) @map("total_price")
  paymentMethod   PaymentMethod  @default(CASH) @map("payment_method")
  reference       String?
  deliveryAddress String?        @map("delivery_address")
  lat             Float?
  lng             Float?
  notes           String?        @db.Text
  serviceType     ServiceType    @default(MESA) @map("service_type")
  tableId         String?        @map("table_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  client     User        @relation("ClientOrders", fields: [clientId], references: [id])
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  rider      User?       @relation("RiderOrders", fields: [riderId], references: [id])
  table      Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  locations  Location[]

  @@index([clientId, createdAt])
  @@index([riderId, status])
  @@index([restaurantId, serviceType, status, createdAt])
  @@index([serviceType, status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  menuItemId String   @map("menu_item_id")
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

model Location {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  orderId   String?  @map("order_id")
  latitude  Float
  longitude Float
  accuracy  Float?
  timestamp DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([timestamp])
  @@map("locations")
}