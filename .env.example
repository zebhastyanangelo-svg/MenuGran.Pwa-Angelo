# Variables de entorno para el frontend (Vite las expone como
# `import.meta.env.VITE_*`). Copia este archivo a `.env.local` y rellena los
# valores reales. `.env.local` ya está cubierto por `.gitignore` (*.local).
#
# Documentación: docs/ARCHITECTURE-STACK.md
#
# IMPORTANTE: Solo se deben exponer al cliente variables públicas (prefijo VITE_).
# Nunca coloques credenciales secretas (service_role, secret keys) aquí.
# La autorización fina la imponen las RLS policies en PostgreSQL.

# ── Supabase (OBLIGATORIAS) ──────────────────────────────────────────────
# URL del proyecto Supabase (Project Settings → API → Project URL).
# Debe ser una URL válida que empiece con https://.
VITE_SUPABASE_URL=https://your-project.supabase.co

# Clave anónima pública (Project Settings → API → anon public).
# Esta clave es segura de exponer al cliente: el acceso se controla vía RLS.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── ImgBB (OPCIONAL) ────────────────────────────────────────────────────
# Clave de API pública para subida de imágenes públicas (logos, fotos de
# menú). Se expone al cliente de forma segura: ImgBB no expone datos sensibles.
# Si falta, se emitirá una advertencia en runtime y la subida de imágenes
# públicas fallará con un error descriptivo.
VITE_IMGBB_API_KEY=your-imgbb-api-key
